{
  "name": "baton",
  "version": "0.1.0",
  "private": true,
  "description": "Baton — know whose turn it is to act on every pull request, and unblock stalled work.",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:sqlite:schema": "node scripts/gen-sqlite-schema.mjs",
    "db:sqlite:push": "prisma db push --schema prisma/schema.sqlite.prisma --force-reset --accept-data-loss",
    "db:sqlite:generate": "prisma generate --schema prisma/schema.sqlite.prisma",
    "worker": "tsx src/worker/index.ts",
    "cron": "tsx src/worker/cron.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@octokit/auth-app": "^7.1.0",
    "@octokit/graphql": "^8.2.1",
    "@octokit/rest": "^21.0.2",
    "@prisma/client": "^6.5.0",
    "next": "15.3.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "15.3.3",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.3.3",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.1",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "eslint-plugin-react@7.37.5": true,
    "eslint-plugin-react-hooks@5.2.0": true,
    "typescript-eslint@8.70.0": true,
    "globals@14.0.0": true,
    "globals@15.15.0": true,
    "@eslint/js@9.39.5": true
  }
}
