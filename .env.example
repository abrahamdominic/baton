# ---- Baton environment ----
# Copy to .env and fill in real values. Never commit .env.

# Canonical public URL (this is also the sitemap/OG/canonical host). No trailing slash.
SITE_URL=https://baton-xi.vercel.app

# Where the app actually runs. Local dev uses localhost; point this at the
# deployed domain in production (OAuth redirects and webhooks are built from it).
APP_URL=https://baton-xi.vercel.app

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development / tests (SQLite mirror of the production Postgres schema).
DATABASE_URL="file:./dev.db"
# Production PostgreSQL. Schema lives in prisma/schema.prisma.
# DATABASE_URL="postgresql://user:password@host:5432/baton?schema=public"

# ---------------------------------------------------------------------------
# GitHub OAuth App (used for user sign-in)
# Create at https://github.com/settings/apps (or a dedicated OAuth App)
# Callback URL: {APP_URL}/auth/callback
# ---------------------------------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# GitHub App (the Baton GitHub App)
# Create at https://github.com/settings/apps
# Webhook URL: {APP_URL}/api/webhooks
# Setup URL: {APP_URL}/auth/install/callback
# User authorization callback URL: {APP_URL}/auth/install/callback
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=abrahamdominic
# GitHub App's OWN OAuth credentials (App settings → Client ID / Client secrets).
# Only needed if the App has "Request user authorization (OAuth) during
# installation" enabled. Never the standalone OAuth App's (GITHUB_OAUTH_*) values.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Base64-encoded PEM (openssl base64 -A < private-key.pem) OR a raw PEM with \n or a path to the file.
GITHUB_APP_PRIVATE_KEY_BASE64=
# Secret configured in the GitHub App settings (Webhook secret).
GITHUB_APP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Supabase backend (billing, payments, subscriptions, admin store)
# Create a project at https://supabase.com, then set:
#   - Project Settings → API → Project URL            → SUPABASE_URL
#   - Project Settings → API → anon / publishable key → SUPABASE_PUBLISHABLE_KEY
#   - Project Settings → API → service_role key       → SUPABASE_SERVICE_ROLE_KEY
# The service-role key must ONLY be used by the server (never shipped to the
# browser). Apply the SQL migrations in supabase/migrations/ to provision tables
# and RLS before enabling billing.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated GitHub logins that are granted the admin role at sign-in
# (bootstrap only). After the first admin exists, manage roles server-side.
BATON_ADMIN_LOGINS=

# ---------------------------------------------------------------------------
# USDC payments (Base network only, native USDC)
# ---------------------------------------------------------------------------
USDC_NETWORK=base
USDC_TOKEN=USDC
# Public receiving wallet for USDC on Base. Never a private key/seed phrase.
USDC_PAYMENT_WALLET_ADDRESS=
# Public JSON-RPC endpoint used for on-chain transaction verification.
USDC_RPC_URL=https://mainnet.base.org
# Native USDC (Bridgeless / "USDC on Base") contract address.
USDC_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Blocks before a transaction is considered confirmed (finality guard).
USDC_MIN_CONFIRMATIONS=12
# Allowed transfer-vs-expected mismatch in 6-decimal minor units (0 = exact).
USDC_AMOUNT_TOLERANCE_MINOR=0

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# sk_test_... / sk_live_...  (create: https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
# Signing secret for your webhook endpoint: {APP_URL}/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# test | live: only affects display labels and safety warnings.
STRIPE_MODE=test

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Datadog/sentry style error tracking is wired but only logs when a URL is set.
# NODE_ENV=production

# Whether to run the in-band scheduler inside the worker (dev convenience).
# BATON_WORKER_POLL_MS=5000
# BATON_CRON_INTERVAL_MIN=360
