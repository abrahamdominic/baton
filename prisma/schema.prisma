// Baton database schema.
//
// This is the canonical schema and targets PostgreSQL in production.
// For local development without Postgres, a SQLite mirror is generated from
// this file (scripts/gen-sqlite-schema.mjs) so the exact same client API and
// shapes are used everywhere. Keep every model compatible with both providers:
// no enums, no @db.* column modifiers, no Postgres-only types.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(cuid())
  githubId       Int              @unique
  login          String
  name           String?
  email          String?
  avatarUrl      String?
  // Account role: "user" (default) or "admin". Admin authorization is enforced
  // server-side in every admin route/action; never trust a client-supplied flag.
  role           String           @default("user")
  suspendedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sessions       Session[]
  audits         AuditLog[]
  installations  AppInstallation[]
  ownedTeams     Team[]               @relation("TeamOwner")
  teamMemberships TeamMember[]        @relation("TeamMembership")
  teamInvitesSent TeamInvite[]        @relation("TeamInviter")
  teamSharesAdded TeamInstallation[]  @relation("TeamInstaller")
  ownedOrganizations Organization[]   @relation("OrgOwner")
  organizationMembers OrganizationMember[]
  organizationInvites OrganizationInvite[] @relation("OrgInviter")
  organizationSharesAdded OrganizationInstallation[] @relation("OrgInstaller")
  conversationsCreated Conversation[]         @relation("ConversationCreator")
  conversationMembers  ConversationMember[]
  messagesSent         Message[]              @relation("MessageSender")
  devicePublicKeys     DevicePublicKey[]      @relation("DeviceOwner")
  notificationsReceived Notification[]        @relation("NotificationRecipient")
  notificationsAuthored Notification[]        @relation("NotificationActor")

  @@index([login])
  @@index([role])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model AppInstallation {
  id              String    @id @default(cuid())
  installationId  Int       @unique
  accountLogin    String
  accountType     String // "User" | "Organization"
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  uninstalledAt   DateTime?
  repos           Repo[]
  teamLinks       TeamInstallation[]
  organizationLinks OrganizationInstallation[]

  @@index([accountLogin])
}

model Repo {
  id               String          @id @default(cuid())
  installationId   String
  installation     AppInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  repoId           BigInt          @unique
  owner            String
  name             String
  fullName         String          @unique
  defaultBranch    String
  isPrivate        Boolean         @default(false)
  enabled          Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  setting          RepoSetting?
  pullRequests     PullRequest[]
  actions          Action[]

  @@index([installationId])
  @@index([owner, name])
  @@index([enabled])
}

model RepoSetting {
  id                    String  @id @default(cuid())
  repoId                String  @unique
  repo                  Repo    @relation(fields: [repoId], references: [id], onDelete: Cascade)
  statusCommentEnabled  Boolean @default(true)
  labelsEnabled         Boolean @default(true)
  nudgesEnabled         Boolean @default(true)
  // Hours before a first-response nudge is fired on a PR with no human reply.
  firstResponseHours    Int     @default(24)
  // Hours before we nudge a reviewer who has not re-reviewed after the author pushed fixes.
  reviewFollowUpHours   Int     @default(36)
  // Hours before we nudge an author who has not responded to requested changes.
  changesRequiredHours  Int     @default(72)
  // Hours of failing CI before the author is nudged.
  ciFailHours           Int     @default(24)
  // Hours of a merge conflict before the author is nudged.
  conflictHours         Int     @default(12)
  // Hours an approved, green PR sits unmerged before the merger is nudged.
  readyToMergeHours     Int     @default(48)
  // Max nudges we will ever send for one state on one PR.
  maxNudgesPerState     Int     @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model PullRequest {
  id                     String    @id @default(cuid())
  repoId                 String
  repo                   Repo      @relation(fields: [repoId], references: [id], onDelete: Cascade)
  number                 Int
  ghNodeId               String?
  title                  String
  url                    String
  authorLogin            String
  headRef                String
  headSha                String
  baseRef                String
  isDraft                Boolean   @default(false)
  githubState            String // OPEN | CLOSED | MERGED
  state                  String // Baton classification, see engine/classification.ts
  mergeableState         String? // UNKNOWN | MERGEABLE | CONFLICTING
  reviewDecision         String? // APPROVED | CHANGES_REQUESTED | REVIEW_REQUIRED | ""
  requestedReviewersJson String    @default("[]")
  labelsJson             String    @default("[]")
  checksJson             String    @default("[]")
  snapshotJson           String    @default("{}")
  stateEnteredAt         DateTime
  githubUpdatedAt        DateTime
  lastCheckedAt          DateTime  @default(now())
  nudgeBucketsJson       String    @default("[]")
  statusCommentId        BigInt?
  firstResponseAt        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  actions                Action[]

  @@unique([repoId, number])
  @@index([repoId, state])
  @@index([repoId, githubUpdatedAt])
  @@index([stateEnteredAt])
  @@index([githubState])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  deliveryId  String
  eventType   String
  rawJson     String
  receivedAt  DateTime @default(now())
  processedAt DateTime?

  @@unique([deliveryId, eventType])
}

model Job {
  id           String    @id @default(cuid())
  kind         String
  status       String    @default("pending") // pending | processing | done | failed | stale
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  payloadJson  String
  error        String?
  nextAttemptAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?

  @@index([status, createdAt])
}

model Action {
  id          String   @id @default(cuid())
  repoId      String?
  repo        Repo?    @relation(fields: [repoId], references: [id], onDelete: Cascade)
  prId        String?
  pr          PullRequest? @relation(fields: [prId], references: [id], onDelete: Cascade)
  type        String // status_comment | label | unlabel | nudge | comment | pr_snapshot
  targetJson  String?
  ghReference String?
  createdAt   DateTime @default(now())

  @@index([repoId, createdAt])
  @@index([prId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actor      String
  action     String
  targetType String
  targetId   String?
  detailJson String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// Team & Organization workspaces
//
// A workspace lets an owner (who pays for the plan) share Baton boards across
// member GitHub installations, invite members, and hand out roles. Invites are
// addressed to a GitHub login; the signed-in user's login gates acceptance, and
// the invite carries a server-issued token for a future link-based flow. Roles:
// owner / admin / member. Workspace entitlements resolve from the owner's
// active subscription (see src/lib/billing/entitlement.ts).
// ---------------------------------------------------------------------------

model Team {
  id           String             @id @default(cuid())
  slug         String             @unique
  name         String
  ownerId      String
  owner        User               @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  members      TeamMember[]
  invites      TeamInvite[]
  installations TeamInstallation[]
  conversations Conversation[] @relation("TeamConversation")


  @@index([ownerId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("TeamMembership", fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member") // owner | admin | member
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamInvite {
  id                String   @id @default(cuid())
  teamId            String
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  githubLogin       String
  email             String?
  role              String   @default("member") // owner | admin | member
  token             String   @unique
  invitedById       String
  invitedBy         User     @relation("TeamInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  status            String   @default("pending") // pending | accepted | revoked | expired
  expiresAt         DateTime
  acceptedByUserId  String?
  createdAt         DateTime @default(now())

  @@unique([teamId, githubLogin])
  @@index([status, expiresAt])
}

model TeamInstallation {
  id             String         @id @default(cuid())
  teamId         String
  team           Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  installationId String         @unique
  installation   AppInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  addedById      String?
  addedBy        User?          @relation("TeamInstaller", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
}

model Organization {
  id            String                @id @default(cuid())
  slug          String                @unique
  name          String
  ownerId       String
  owner         User                  @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  members       OrganizationMember[]
  invites       OrganizationInvite[]
  installations OrganizationInstallation[]
  policy        OrganizationPolicy?
  conversations Conversation[]           @relation("OrgConversation")

  @@index([ownerId])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member") // owner | admin | member
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationInvite {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  githubLogin       String
  email             String?
  role              String       @default("member") // owner | admin | member
  token             String       @unique
  invitedById       String
  invitedBy         User         @relation("OrgInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  status            String       @default("pending") // pending | accepted | revoked | expired
  expiresAt         DateTime
  acceptedByUserId  String?
  createdAt         DateTime     @default(now())

  @@unique([organizationId, githubLogin])
  @@index([status, expiresAt])
}

model OrganizationInstallation {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installationId String         @unique
  installation   AppInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  addedById      String?
  addedBy        User?          @relation("OrgInstaller", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
}

model OrganizationPolicy {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstResponseHours   Int          @default(24)
  reviewFollowUpHours  Int          @default(36)
  changesRequiredHours Int          @default(72)
  ciFailHours          Int          @default(24)
  conflictHours        Int          @default(12)
  readyToMergeHours    Int          @default(48)
  maxNudgesPerState    Int          @default(1)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

// ---------------------------------------------------------------------------
// Messaging (E2E-encrypted) + centralized notifications
//
// Encrypted messages and conversation keys live here. No plaintext ever
// touches the database or Supabase: only ciphertext blobs and per-member
// wrapped thread-key payloads are stored. Membership/read-state/authorization
// is enforced server-side and via RLS on every query.
// ---------------------------------------------------------------------------

model Conversation {
  id            String                  @id @default(cuid())
  kind          String                  @default("direct") // direct | team | org
  orgId         String?
  org           Organization?           @relation("OrgConversation", fields: [orgId], references: [id], onDelete: Cascade)
  teamId        String?
  team          Team?                   @relation("TeamConversation", fields: [teamId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User                    @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  lastMessageAt DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  members       ConversationMember[]
  messages      Message[]
  threadKeys    ConversationThreadKey[]

  @@index([orgId, lastMessageAt])
  @@index([teamId, lastMessageAt])
  @@index([createdById])
  @@index([lastMessageAt])
}

model ConversationMember {
  id             String               @id @default(cuid())
  conversationId String
  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String               @default("member") // owner | admin | member
  joinedAt       DateTime             @default(now())
  lastReadAt     DateTime?
  lastReadMsgId  String?
  keyWraps       ConversationKeyWrap[]

  @@unique([conversationId, userId])
  @@index([userId])
}

// A thread-key "epoch". Each epoch carries a fresh AES-256 key; the key is
// never stored in plaintext — only as per-member wraps (see ConversationKeyWrap).
// The epoch is bumped when membership changes so removed members lose access and
// newly added members receive an independent wrap for the same or next key.
model ConversationThreadKey {
  id             String                  @id @default(cuid())
  conversationId String
  conversation   Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  epoch          Int
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  wraps          ConversationKeyWrap[]
  messages       Message[]

  @@unique([conversationId, epoch])
  @@index([conversationId, active])
}

// One wrap of a thread key for one member, encrypted under that member's
// device public key (ECDH P-256 => AES-256-GCM). Holds no plaintext.
model ConversationKeyWrap {
  id              String               @id @default(cuid())
  threadKeyId     String
  threadKey       ConversationThreadKey @relation(fields: [threadKeyId], references: [id], onDelete: Cascade)
  memberId        String
  member          ConversationMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  publicKeyId     String
  publicKey       DevicePublicKey       @relation(fields: [publicKeyId], references: [id], onDelete: Cascade)
  wrappedKeyB64   String
  createdAt       DateTime              @default(now())

  @@unique([threadKeyId, memberId, publicKeyId])
  @@index([memberId])
}

model Message {
  id             String                 @id @default(cuid())
  conversationId String
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  threadKeyId    String
  threadKey      ConversationThreadKey  @relation(fields: [threadKeyId], references: [id], onDelete: Cascade)
  // AES-GCM payload: base64(iv | tag | ciphertext). Never plaintext.
  ciphertext     String
  nonce          String                 @default("")
  clientMessageId String
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime               @default(now())

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([conversationId, createdAt, senderId])
}

// Device-scoped ECDH public keys. The private key is generated client-side and
// never leaves the user's device/app. publicKeyB64 is the imported SPKI blob.
model DevicePublicKey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("DeviceOwner", fields: [userId], references: [id], onDelete: Cascade)
  label        String   @default("Baton device")
  publicKeyB64 String
  fingerprint  String
  createdAt    DateTime @default(now())
  revokedAt    DateTime?
  wraps        ConversationKeyWrap[]

  @@unique([userId, fingerprint])
  @@index([userId])
}

// Centralized notification inbox. One row per recipient per event; read state
// is per-row so each user's unread badge is derived exactly from the inbox.
// Payload carries only type + resource identifiers (never message plaintext).
model Notification {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type         String // "message" | "mention" | "review" | "invite" | "system"
  resourceType String // "message" | "conversation" | "pr" | "team_invite" | "org_invite" | "billing"
  resourceId   String
  actorId      String?
  actor        User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  contextJson  String   @default("{}") // ids/keys only, no plaintext content
  readAt       DateTime?
  createdAt    DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, type, resourceId])
  @@index([resourceType, resourceId])
}